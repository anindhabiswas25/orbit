# ════════════════════════════════════════════════════════
# ORBIT PROTOCOL — Environment Configuration
# Copy to .env. NEVER commit .env to version control.
# ════════════════════════════════════════════════════════

# ── Avalanche Fuji RPC ───────────────────────────────────
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# FUJI_RPC_URL=https://avalanche-fuji.infura.io/v3/YOUR_INFURA_KEY
# FUJI_RPC_URL=https://avax-fuji.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── Deployer Wallet ──────────────────────────────────────
# Owns all contracts. Must have: ≥2 AVAX + ≥50 USDC on Fuji
DEPLOYER_PRIVATE_KEY=0x...

# ── Agent Wallets ────────────────────────────────────────
AGENT_PRIVATE_KEY=0x...
DEMO_AGENT_A_KEY=0x...
DEMO_AGENT_B_KEY=0x...
DEMO_AGENT_C_KEY=0x...

# ── Developer Wallets (receive agent payments) ────────────
DEMO_DEV_WALLET_A=0x...
DEMO_DEV_WALLET_B=0x...
DEMO_DEV_WALLET_C=0x...

# ── Tokens ───────────────────────────────────────────────
USDC_ADDRESS=0x3E937B4881CBd500d05EeDAB7BA203f2b7B3f74f

# ── x402 Payment Facilitator ────────────────────────────
X402_FACILITATOR_URL=

# ── Agent Process Config ─────────────────────────────────
AGENT_NAME=ReliableScout
LOG_LEVEL=info

# ── Backend Server ───────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000

# ── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── SnowTrace API (for contract verification) ────────────
SNOWTRACE_API_KEY=YourApiKeyHere
