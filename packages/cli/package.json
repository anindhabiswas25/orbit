{
  "name": "@orbit/cli",
  "version": "1.0.0",
  "description": "Orbit Protocol Agent CLI — register, run, and monitor agents on Avalanche Fuji",
  "bin": { "orbit": "./dist/index.js" },
  "main": "./dist/index.js",
  "files": ["dist/", "README.md"],
