# ── Network ───────────────────────────────────────────────────────────
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# ── Orchestrator Wallet ───────────────────────────────────────────────
# Must be set as orchestrator in FeePool and PaymentLedger
# Must have ≥0.5 AVAX for gas
ORCHESTRATOR_PRIVATE_KEY=0x...

# ── Groq LLM (free tier: 14,400 RPD) ─────────────────────────────────
# Sign up at https://console.groq.com (no credit card required)
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_MAX_TOKENS=500

# ── Contract Addresses (from deployed-addresses.json) ─────────────────
CONTRACT_AGENT_SELECTION_ENGINE=0x...
CONTRACT_AGENT_REGISTRY=0x...
CONTRACT_YIELD_REGISTRY=0x...
CONTRACT_YIELD_VAULT=0x...
CONTRACT_FEE_POOL=0x...
CONTRACT_PAYMENT_LEDGER=0x...
CONTRACT_USDC=0x3E937B4881CBd500d05EeDAB7BA203f2b7B3f74f

# ── Payment Rules ─────────────────────────────────────────────────────
MIN_POOL_RESERVE=10000000
MAX_PAYMENT_USDC=100000
PAYMENT_RETRY_MAX=3

# ── Dynamic Payment Scaling ──────────────────────────────────────────
# Pool balance where executors get 100% payment rate (100 USDC)
OPTIMAL_POOL_BALANCE=100000000
# Minimum payment rate (10% of base) before dropping to $0
MIN_HEALTH_FACTOR=0.10
# Payments below this threshold are skipped (0.01 USDC)
MIN_PAYMENT_USDC=10000

# ── Alerts ────────────────────────────────────────────────────────────
ALERT_WEBHOOK_URL=

# ── x402 Receipt ──────────────────────────────────────────────────────
RECEIPT_TIMEOUT_MS=10000

# ── Server ────────────────────────────────────────────────────────────
PORT=5000
LOG_LEVEL=info
